{
  "name": "buzzzz",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "bun run --cwd apps/relay typegen",
    "dev": "vp run --filter @buzzzz/studio --filter @buzzzz/preview --parallel dev",
    "dev:studio": "vp run @buzzzz/studio#dev",
    "dev:preview": "vp run @buzzzz/preview#dev",
    "ios": "bun run --filter @buzzzz/preview ios --device --port 8082",
    "android": "bun run --filter @buzzzz/preview android --port 8082",
    "build": "vp run @buzzzz/studio#build",
    "typecheck": "bun run typecheck:tools && vp run --filter @buzzzz/* typecheck",
    "lint": "vp lint --deny-warnings apps packages __tests__ playwright.config.ts vite.config.mts",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "test": "bun test packages apps",
    "test:relay": "bun run --cwd apps/relay test:integration",
    "analyze": "fallow dead-code --fail-on-issues && fallow architecture --fail-on-issues",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run test:relay && bun run build && bun run analyze",
    "test:browser": "playwright test",
    "sync:sound-reference": "bun __tests__/browser/fixtures/pulsar/sync.mts",
    "check:all": "bun run check && bun run test:browser",
    "analyze:health": "fallow",
    "typecheck:tools": "tsc --project tsconfig.tools.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@buzzzz/core": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/bun": "1.4.3",
    "fallow": "3.33.1",
    "fflate": "^0.8.3",
    "typescript": "~6.0.3",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "@rive-app/react-native@0.5.5": "patches/@rive-app__react-native@0.5.5.patch",
    "lottie-react-native@7.3.8": "patches/lottie-react-native@7.3.8.patch",
    "react-native-pulsar@1.7.0": "patches/react-native-pulsar@1.7.0.patch"
  }
}
