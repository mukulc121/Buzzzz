{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "resolveJsonModule": true
  },
  "exclude": ["apps/relay/**"],
  "include": [
    "__tests__/**/*.ts",
    "apps/**/__tests__/**/*.ts",
    "packages/core/scripts/**/*.mts",
    "packages/**/__tests__/**/*.ts",
    "playwright.config.ts",
    "vite.config.mts"
  ]
}
