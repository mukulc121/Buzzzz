{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "buzzzz-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8787,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
  "vars": {
    "STUDIO_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "SESSION_TTL_SECONDS": "86400",
    "PAIR_TTL_SECONDS": "600",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RelayRoom",
      },
      {
        "name": "PAIRING_CODES",
        "class_name": "PairingCode",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PairingCode"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "buzzzz-assets",
    },
  ],
  "ratelimits": [
    {
      "name": "EDGE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "PAIRING_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
}
