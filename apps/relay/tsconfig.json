{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"]
  },
  "include": [
    "src",
    "__tests__/**/*.ts",
    "__tests__/**/*.mts",
    ".wrangler/worker-configuration.d.ts"
  ]
}
